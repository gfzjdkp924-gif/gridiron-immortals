{
  "name": "team-site-template",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:store": "STORE_BUILD=1 vite build && bun tools/store-build-check.mjs store",
    "build:store:ios": "STORE_PLATFORM=ios bun run build:store",
    "build:store:android": "STORE_PLATFORM=android bun run build:store",
    "check:web": "bun tools/store-build-check.mjs web",
    "check:edition": "bun tools/store-edition-check.mjs",
    "publish:store-local": "STORE_BUILD=1 bash ./publish.sh",
    "store:www": "bash ./tools/make-store-www.sh",
    "store:www:ios": "STORE_PLATFORM=ios bash ./tools/make-store-www.sh ios",
    "store:www:android": "STORE_PLATFORM=android bash ./tools/make-store-www.sh android",
    "start": "bun run serve.ts",
    "publish": "bash ./publish.sh",
    "go-live": "bash ./go-live.sh",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-router": "^1.158.1",
    "@tanstack/react-start": "^1.158.3",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5"
  }
}
